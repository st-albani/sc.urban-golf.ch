{
  "name": "urban-golf-frontend",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "preview:test": "vite preview --mode test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:e2e:smoke:headed": "playwright test --config=playwright.smoke.config.ts --headed",
    "test:visual": "node e2e/visual-audit.mjs",
    "test:all": "npm run lint && npm run type-check && npm run test && npm run test:e2e:smoke"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@urban-golf/contract": "*",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "jsqr": "^1.4.0",
    "marked": "^18.0.13",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
